{# Page de documentation de l'API (Swagger UI) aux couleurs de Ludmigo, comme le back office #}
{# API documentation page (Swagger UI) in Ludmigo's colours, like the back office #}
{% extends '@!ApiPlatform/SwaggerUi/index.html.twig' %}

{% block title %}
    <title>{{ title ?: 'Ludmigo API' }} - Documentation</title>
{% endblock %}

{% block stylesheet %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('ui/style.css') }}">
    {# Mode soirée posé avant l'affichage : même clé que le back office, pas d'éclair clair #}
    {# Evening mode set before rendering: same key as the back office, no light flash #}
    <script>
        (function () {
            var night;
            try { night = localStorage.getItem('ludmigo.admin.night'); } catch (e) { night = null; }
            if (night === null) { night = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? '1' : '0'; }
            if (night === '1') { document.documentElement.classList.add('night'); }
        })();
    </script>
{% endblock %}

{% block header %}
    {# <div> et non <header> : la feuille de style d'API Platform cible la balise header #}
    {# <div> and not <header>: the API Platform stylesheet targets the header tag #}
    <div class="ludmigo-header" role="banner">
        <a class="ludmigo-logo" href="{{ path('api_entrypoint') }}" aria-label="Ludmigo, documentation de l'API">
            <img class="logo-light" src="{{ asset('ui/logo-noir.svg') }}" alt="Ludmigo" width="112" height="32">
            <img class="logo-night" src="{{ asset('ui/logo-blanc.svg') }}" alt="" width="112" height="32">
        </a>
        <p class="ludmigo-title">Documentation de l'API</p>
        <a class="ludmigo-link" href="/admin/">Back office</a>
        <button type="button" id="night-toggle" class="ludmigo-night" aria-pressed="false" aria-label="Mode soirée">
            <svg class="icon-moon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
            <svg class="icon-sun" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
    </div>
    <script src="{{ asset('ui/night.js') }}" defer></script>
{% endblock %}
