# Environnement de test (utilisé par PHPUnit)
# Test environment (used by PHPUnit)
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test-secret
DATABASE_URL="mysql://ludmigo:ludmigo@127.0.0.1:3306/ludmigo_test?serverVersion=mariadb-10.11.0&charset=utf8mb4"
# Pour tester sur PostgreSQL, surcharger dans api/.env.test.local :
# To test on PostgreSQL, override in api/.env.test.local:
# DATABASE_URL="postgresql://ludmigo:ludmigo@127.0.0.1:5432/ludmigo_test?serverVersion=17&charset=utf8"

# Clés JWT de test, générées par tests/bootstrap.php (jamais utilisées en production)
# Test JWT keys, generated by tests/bootstrap.php (never used in production)
JWT_SECRET_KEY=%kernel.project_dir%/var/jwt-test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/jwt-test/public.pem
JWT_PASSPHRASE=test-passphrase
