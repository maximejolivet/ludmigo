# Variables d'environnement par défaut (versionnées). Les surcharges vont dans .env.local (jamais versionné).
# Default environment variables (committed). Overrides go in .env.local (never committed).
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-in-env-local
DATABASE_URL="mysql://ludmigo:ludmigo@127.0.0.1:3306/ludmigo?serverVersion=mariadb-10.11.0&charset=utf8mb4"
# PostgreSQL à la place de MariaDB (`make db-up DB=postgres`) :
# PostgreSQL instead of MariaDB (`make db-up DB=postgres`):
# DATABASE_URL="postgresql://ludmigo:ludmigo@127.0.0.1:5432/ludmigo?serverVersion=17&charset=utf8"

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
