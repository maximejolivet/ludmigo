meta {
  name: Get me
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns the profile without password", function () {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.be.a("string");
    expect(res.body).to.not.have.property("password");
  });
}

docs {
  Profil de l'utilisateur connecté. Nécessite d'avoir lancé Login (401 sans jeton).
  Profile of the signed-in user. Run Login first (401 without a token).
}
