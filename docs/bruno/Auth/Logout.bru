meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

tests {
  test("refresh token revoked", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Déconnexion : révoque le refresh token. Le JWT reste valable jusqu'à son expiration (1 h).
  Sign-out: revokes the refresh token. The JWT stays valid until it expires (1 h).
}
