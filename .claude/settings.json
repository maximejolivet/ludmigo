{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npm outdated:*)",
      "Bash(npx tsc:*)",
      "Bash(composer:*)",
      "Bash(php bin/console:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
